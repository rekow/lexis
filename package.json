{
  "name": "lexis",
  "description": "a very simple lexer",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "David Rekow",
    "email": "d@davidrekow.com",
    "url": "http://davidrekow.com"
  },
  "keywords": [
    "lex",
    "lexer",
    "lexis",
    "token",
    "tokenize",
    "tokens"
  ],
  "homepage": "https://github.com/davidrekow/lexis",
  "bugs": "https://github.com/davidrekow/lexis/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidrekow/lexis.git"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . && tsc -p test",
    "pretest": "npm run -s build",
    "test": "vitest run",
    "check": "npm test && npm run -s typecheck && npm run -s check:package",
    "check:package": "publint && attw --pack .",
    "prepack": "npm run -s build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
